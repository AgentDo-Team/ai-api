# App
APP_ENV=local
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://edu:1234@localhost:5432/edudb

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=

# MCP
MCP_SERVER_URLS=

# Auth (JWT)
# SECRET_KEY: JWT 서명용 비밀키. 아래 명령으로 생성한 값을 넣으세요.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=local
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://edu:1234@localhost:5432/edudb

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding (로컬 Ollama에 미리 pull 해둬야 함: `ollama pull bge-m3`)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# MCP
MCP_SERVER_URLS=
